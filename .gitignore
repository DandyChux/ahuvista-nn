# Ignore build artifacts and cache
/target/

# Ignore documentation generated by `cargo doc`
/doc/

# Ignore dependency sources, downloaded by Cargo
# These are typically stored in the user's home directory, but can be configured to be project-local
.cargo/

# Ignore editor and IDE specific files
.vscode/
.zed/
.idea/
*.iml
*.sublime-project
*.sublime-workspace
# CLion specific files
cmake-build-*/

# Ignore OS-specific files
.DS_Store
Thumbs.db

# Ignore log files
*.log
logs/

# Ignore environment variables
.env
.env.*
!.env.example

# In a library crate, you may want to ignore the Cargo.lock file.
# For an application, it is recommended to commit it.
# Cargo.lock

# Backup files
*.rs.bk
*.swp
*~

# Ignore datasets directory (must provide your own data)
datasets/

# SQLite database files
*.db
*.db-wal
*.db-shm

# Binary output files
*.exe
*.dll
*.so
*.dylib
*.bin
