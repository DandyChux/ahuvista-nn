// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
	{
		"adapter": "CodeLLDB",
		"label": "Debug Prepare",
		"request": "launch",
		"build": {
			"command": "cargo",
			"args": ["build", "--bin", "ahuvista", "--features", "prepare"],
			"cwd": "${ZED_WORKTREE_ROOT}",
		},
		"program": "${ZED_WORKTREE_ROOT}/target/debug/ahuvista",
		"args": [
			"prepare",
			"--data-dir",
			"datasets",
			"--database",
			"ahuvista.db",
			"--manifest",
			"datasets/manifest.json",
			"--clear",
			"--verbose",
		],
		"cwd": "${ZED_WORKTREE_ROOT}",
		"stopOnEntry": false,
		"env": {
			"RUST_LOG": "debug,ahuvista_nn=trace",
			"RUST_BACKTRACE": "1",
		},
	},
	{
		"adapter": "CodeLLDB",
		"label": "Debug Train",
		"request": "launch",
		"build": {
			"command": "cargo",
			"args": ["build", "--bin", "ahuvista", "--features", "train"],
			"cwd": "${ZED_WORKTREE_ROOT}",
		},
		"program": "${ZED_WORKTREE_ROOT}/target/debug/ahuvista",
		"args": [
			"train",
			"--database",
			"ahuvista.db",
			"--output-dir",
			"models",
			"--epochs",
			"1",
			"--batch-size",
			"512",
			"--no-privacy",
			"--verbose",
		],
		"cwd": "${ZED_WORKTREE_ROOT}",
		"stopOnEntry": false,
		"env": {
			"RUST_LOG": "debug,ahuvista_nn=trace",
			"RUST_BACKTRACE": "1",
		},
	},
	{
		"adapter": "CodeLLDB",
		"label": "Debug Train with Config",
		"request": "launch",
		"build": {
			"command": "cargo",
			"args": ["build", "--bin", "ahuvista", "--features", "train"],
			"cwd": "${ZED_WORKTREE_ROOT}",
		},
		"program": "${ZED_WORKTREE_ROOT}/target/debug/ahuvista",
		"args": [
			"train",
			"--config",
			"config.json",
			"--database",
			"ahuvista.db",
			"--output-dir",
			"models",
			"--verbose",
		],
		"cwd": "${ZED_WORKTREE_ROOT}",
		"stopOnEntry": false,
		"env": {
			"RUST_LOG": "trace",
			"RUST_BACKTRACE": "full",
			"RUST_MIN_STACK": "8388608",
		},
	},
	{
		"adapter": "CodeLLDB",
		"label": "Debug Predict",
		"request": "launch",
		"build": {
			"command": "cargo",
			"args": ["build", "--bin", "ahuvista", "--features", "predict"],
			"cwd": "${ZED_WORKTREE_ROOT}",
		},
		"program": "${ZED_WORKTREE_ROOT}/target/debug/ahuvista",
		"args": [
			"predict",
			"--model",
			"models/maternal-risk.ahv",
			"--input",
			"input.json",
			"--output",
			"prediction.json",
			"--verbose",
		],
		"cwd": "${ZED_WORKTREE_ROOT}",
		"stopOnEntry": false,
		"env": {
			"RUST_LOG": "debug,ahuvista_nn=trace",
			"RUST_BACKTRACE": "1",
		},
	},
	{
		"adapter": "CodeLLDB",
		"label": "Debug Serve",
		"request": "launch",
		"build": {
			"command": "cargo",
			"args": ["build", "--bin", "ahuvista", "--features", "serve"],
			"cwd": "${ZED_WORKTREE_ROOT}",
		},
		"program": "${ZED_WORKTREE_ROOT}/target/debug/ahuvista",
		"args": [
			"serve",
			"--model",
			"models/maternal-risk.ahv",
			"--bind",
			"127.0.0.1:8080",
		],
		"cwd": "${ZED_WORKTREE_ROOT}",
		"stopOnEntry": false,
		"env": {
			"RUST_LOG": "debug,ahuvista_nn=trace",
			"RUST_BACKTRACE": "1",
		},
	},
	{
		"adapter": "CodeLLDB",
		"label": "Debug Model Tests",
		"request": "launch",
		"build": {
			"command": "cargo",
			"args": ["test", "--no-run", "--lib"],
			"cwd": "${ZED_WORKTREE_ROOT}",
		},
		"program": "${ZED_WORKTREE_ROOT}/target/debug/deps/ahuvista_nn-${ZED_RANDOM}",
		"args": ["models::", "--nocapture"],
		"cwd": "${ZED_WORKTREE_ROOT}",
		"stopOnEntry": false,
		"env": {
			"RUST_LOG": "debug",
			"RUST_BACKTRACE": "1",
		},
	},
	{
		"adapter": "CodeLLDB",
		"label": "Debug Train Release",
		"request": "launch",
		"build": {
			"command": "cargo",
			"args": [
				"build",
				"--release",
				"--bin",
				"ahuvista",
				"--features",
				"train",
			],
			"cwd": "${ZED_WORKTREE_ROOT}",
		},
		"program": "${ZED_WORKTREE_ROOT}/target/release/ahuvista",
		"args": [
			"train",
			"--config",
			"config.json",
			"--database",
			"ahuvista.db",
			"--output-dir",
			"models",
		],
		"cwd": "${ZED_WORKTREE_ROOT}",
		"stopOnEntry": false,
		"env": {
			"RUST_LOG": "info",
			"RUST_BACKTRACE": "1",
		},
	},
	{
		"adapter": "CodeLLDB",
		"label": "Attach to Running Process",
		"request": "attach",
		"pid": "${ZED_PICK_PID}",
		"stopOnEntry": false,
	},
]
