{
	"modalities": {
		"use_sequence": true,
		"use_text": false,
		"use_image": false
	},
	"data_paths": {
		"data_dir": "datasets",
		"patient_id_column": "patient_id",
		"sequence_files": null,
		"text_files": null,
		"image_files": null
	},
	"training": {
		"epochs": 50,
		"batch_size": 256,
		"learning_rate": 0.005,
		"val_frequency": 1,
		"weight_decay": 0.001,
		"use_privacy": true,
		"privacy_epsilon": 10.0,
		"privacy_delta": 0.00001,
		"gradient_clip_norm": 5.0,
		"use_adaptive_lr": true,
		"lr_decay_rate": 0.95,
		"lr_decay_epochs": 5,
		"min_learning_rate": 0.001
	},
	"model": {
		"sequence_hidden_size": 32,
		"sequence_output_size": 16,
		"text_embedding_dim": 50,
		"text_hidden_size": 32,
		"text_max_vocab": 5000,
		"image_channels": 3,
		"image_height": 224,
		"image_width": 224,
		"classifier_hidden_sizes": [64, 32]
	}
}
