{
	"modalities": {
		"use_tabular": true,
		"use_temporal": false,
		"use_text": false,
		"use_image": false
	},
	"data_paths": {
		"data_dir": "datasets",
		"patient_id_column": "PatientID",
		"tabular_files": [
			"tabular_data.csv"
		],
		"temporal_files": [
			"temporal_data.csv"
		],
		"text_files": null,
		"image_files": null
	},
	"training": {
		"epochs": 50,
		"batch_size": 32,
		"learning_rate": 0.001,
		"use_privacy": false,
		"privacy_epsilon": 10.0,
		"gradient_clip_norm": 5.0,
		"use_adaptive_lr": true,
		"lr_decay_rate": 0.95,
		"lr_decay_steps": 100,
		"min_learning_rate": 0.001
	},
	"model": {
		"tabular_hidden_sizes": [
			64,
			32
		],
		"tabular_output_size": 16,
		"temporal_hidden_size": 32,
		"temporal_output_size": 16,
		"text_embedding_dim": 50,
		"text_hidden_size": 32,
		"text_max_vocab": 5000,
		"image_channels": 3,
		"image_height": 224,
		"image_width": 224,
		"classifier_hidden_sizes": [
			64,
			32
		]
	}
}
