							"avg_sys_bp": "systolic_bp_avg",
							"max_sys_bp": "systolic_bp_max",
							"avg_dia_bp": "diastolic_bp_avg",
							"max_dia_bp": "diastolic_bp_max",
							"min_spo2": "spo2_min"
						}
					}
				}
			]
		},
